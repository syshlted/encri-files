# Claude Code local config. The exception is .claude/rules/: the per-component briefs that
# load when their files are touched are part of the project's documentation, as in encri (encri D127, F12).
.claude/*
!.claude/rules/

# A release's signed outputs are copied here from the key machine, and never committed: the other
# repositories each found a signed/ directory untracked and one `git add .` from being pushed.
signed/

# Gradle
.gradle/
build/
captures/

# Android SDK location — machine-specific, never committed
local.properties

# Kotlin
.kotlin/

# Python's bytecode cache, written beside a script that is imported
__pycache__/

# Eclipse/Kotlin-LSP output. Not Gradle's — Gradle writes to build/ — so the build/ rule above
# does not cover it, and these directories hold stale copies of sources that grep will return.
bin/

# IDE
.idea/
*.iml

# Written by `--write-locks` for the version catalog's own configuration, and empty: nothing in settings
# is locked. The lockfiles that matter are the modules' gradle.lockfile (encri-api L10).
settings-gradle.lockfile
